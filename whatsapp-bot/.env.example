# Boss list awal (comma-separated nomor, format: 6281234567890)
# Bisa ditambah/dihapus runtime via /boss-add, /boss-remove
WA_INITIAL_BOSSES=

# Claude Code config
CLAUDE_MODEL=sonnet
CLAUDE_PERMISSION_MODE=bypassPermissions
CLAUDE_TIMEOUT_MS=600000
# CLAUDE_DEFAULT_CWD=C:\Users\USER\Desktop\paper-trading
# CLAUDE_BIN=claude

# Log level Baileys: trace, debug, info, warn, error
LOG_LEVEL=warn
