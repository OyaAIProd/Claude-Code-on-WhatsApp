# Telegram Bot Token dari @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID yang boleh chat ke bot (comma-separated). Kosongin = semua boleh.
TELEGRAM_ALLOWED_CHAT_IDS=

# Permission mode Claude: bypassPermissions | acceptEdits | default | plan | auto
CLAUDE_PERMISSION_MODE=bypassPermissions

# Model: sonnet | opus | haiku atau full ID claude-sonnet-4-6
CLAUDE_MODEL=sonnet

# Timeout per pesan (ms). Default 180000 = 3 menit.
CLAUDE_TIMEOUT_MS=180000

# Override path ke claude binary (kalau gak di PATH)
# CLAUDE_BIN=C:\path\to\claude.exe

# Groq API untuk voice transcription Whisper (gratis: console.groq.com)
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3

# Default cwd Claude Code (kosong = user home directory)
CLAUDE_DEFAULT_CWD=
